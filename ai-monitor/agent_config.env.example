# Agent-Based Monitor Configuration

# Add these environment variables to your .env file to configure the agent-based monitor

# ============================================================================
# Agent Monitor Mode
# ============================================================================
# AI_MONITOR_MODE=agent  # "rules" (current) | "hybrid" | "agent" (new)

# ============================================================================
# LLM Configuration (inherited from existing config)
# ============================================================================
# CLAUDE_API_KEY=sk-ant-...
# CLAUDE_MODEL=claude-3-5-sonnet-20241022
# GEMINI_API_KEY=...
# GEMINI_MODEL=gemini-2.0-flash-exp

# ============================================================================
# Agent-Specific Configuration
# ============================================================================

# Maximum tool calls per investigation (prevent runaway costs)
AI_MONITOR_MAX_TOOL_CALLS=20

# Maximum investigation time in seconds (prevent stuck investigations)
AI_MONITOR_MAX_INVESTIGATION_TIME_SECONDS=300

# ============================================================================
# Guardrails (Safety Limits)
# ============================================================================

# Containers that can be restarted by the agent (comma-separated)
# Leave empty to allow all containers
AI_MONITOR_ALLOWED_CONTAINERS=prometheus,grafana,influxdb3-core,nginx-proxy-manager,telegraf,mosquitto

# Cooldown period between restarts of the same container (seconds)
AI_MONITOR_GUARDRAIL_COOLDOWN_SECONDS=600

# Maximum restarts across all containers per hour
AI_MONITOR_GUARDRAIL_MAX_RESTARTS_PER_HOUR=3

# ============================================================================
# Execution Mode
# ============================================================================

# Whether to execute actions (false = dry-run mode)
AI_MONITOR_EXECUTE=false

# ============================================================================
# Monitoring Configuration (inherited)
# ============================================================================
# AI_MONITOR_INTERVAL_SECONDS=60
# AI_MONITOR_METRICS_PORT=8000
# AI_MONITOR_LOG_LEVEL=info
# PROMETHEUS_URL=http://prometheus:9090

# ============================================================================
# Incident Reports
# ============================================================================
# AI_MONITOR_INCIDENT_REPORTS_DIR=/app/incidents
